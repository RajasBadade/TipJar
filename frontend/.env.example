# Soroban RPC endpoint. Used as a fallback when Freighter does not report one.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase fallback, e.g. "Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Fill these in after deploying the Soroban contracts in /contracts
NEXT_PUBLIC_CREATOR_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_TIPJAR_CONTRACT_ID=
